{
  "extensions": [
    ".csv",
    ".tsv",
    ".xlsx",
    ".xlsm",
    ".xls",
    ".ods",
    ".json",
    ".jsonl",
    ".ndjson"
  ],
  "sniff_extensions": [
    ".txt",
    ".dat",
    ".data",
    ".tab",
    ".psv",
    ".log",
    ".out",
    ".list",
    ""
  ],
  "skip_file_names": [
    "package.json",
    "package-lock.json",
    "npm-shrinkwrap.json",
    "bower.json",
    "composer.json",
    "tsconfig*.json",
    "jsconfig*.json",
    ".eslintrc*.json",
    "tslint.json",
    ".prettierrc*.json",
    "babel.config.json",
    ".babelrc*.json",
    "lerna.json",
    "nx.json",
    "turbo.json",
    "deno.json",
    "angular.json",
    "vercel.json",
    "firebase.json",
    "renovate.json",
    "devcontainer.json",
    "launch.json",
    "tasks.json",
    "extensions.json",
    "settings.json",
    "settings.local.json",
    "manifest.json",
    "cdk.json",
    "*.schema.json",
    "*.tsbuildinfo.json"
  ],
  "max_rows": 20000,
  "max_values_per_column": 500,
  "max_files_per_search": 2000,
  "max_check_seconds": 20,
  "confirmation_window_seconds": 300,
  "remember_confirmation_for_session": true,
  "override_token": "#allow-data",
  "tool_action": "ask",
  "allowlist": [],
  "trusted_files": {}
}
